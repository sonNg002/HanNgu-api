# Cấu hình local; trên hosting đặt NODE_ENV=production và CORS_ORIGINS HTTPS.
# Firebase Admin chỉ xác thực token; Firestore REST dùng ID token của người dùng.
NODE_ENV=development
PORT=8080
HOST=127.0.0.1
FIREBASE_PROJECT_ID=hanngu-91a22
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
BODY_LIMIT_BYTES=8388608
UPSTREAM_TIMEOUT_MS=20000
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
SHUTDOWN_TIMEOUT_MS=10000
