# Chỉ dùng project demo cùng emulator; không trộn token demo với Firestore thật.
# Firestore emulator dùng 8180 để không trùng port 8080 của API.
NODE_ENV=development
PORT=8080
HOST=127.0.0.1
FIREBASE_PROJECT_ID=demo-hanngu
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8180
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
